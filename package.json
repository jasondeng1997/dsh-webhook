{
  "name": "dsh-webhook",
  "version": "0.1.2",
  "description": "Bridge any HTTP webhook into DeepSeek Harness sessions: verify, route, prompt an agent, and push the answer back to your endpoint.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "webhook",
    "bridge",
    "plugin",
    "cordis",
    "agent",
    "automation"
  ],
  "license": "MIT",
  "author": "JasonDeng",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.js.map",
    "lib/types/**/*.d.ts",
    "examples/**/*.mjs",
    "examples/**/*.yml",
    "examples/**/*.md",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build -- --check",
    "demo": "npm run build --silent && node examples/demo.mjs",
    "example:bridge": "npm run build --silent && node examples/local-bridge.mjs",
    "example:trigger": "node examples/trigger.mjs",
    "example:smoke": "npm run build --silent && node examples/smoke.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-alpha.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/dsh-tools": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
